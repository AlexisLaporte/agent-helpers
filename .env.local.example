# Example environment configuration for Agent Helpers
# Copy this file to .env.local and customize for your setup

# Development server port
# Default: 3000 (Next.js default)
# This project uses: 3011 (to avoid conflicts with other Next.js projects)
PORT=3011

# Add other environment variables below as needed
# Example:
# DATABASE_URL=postgresql://...
# API_KEY=your-api-key
