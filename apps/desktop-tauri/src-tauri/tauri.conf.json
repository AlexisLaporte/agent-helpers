{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Code Manager",
  "version": "0.2.0",
  "identifier": "com.agenthelpers.claude-code-manager",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/AlexisLaporte/claude-code-manager/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  },
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Claude Code Manager",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png"],
    "category": "Development",
    "shortDescription": "Manage Claude Code configurations",
    "longDescription": "A lightweight desktop app to manage ~/.claude/ directories and Claude Code project configurations. Edit CLAUDE.md files, skills, commands, and settings with syntax highlighting.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "section": "devel"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
