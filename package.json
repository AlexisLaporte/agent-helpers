{
  "name": "agent-helpers",
  "version": "0.1.2",
  "description": "Agent Helpers - Manage Claude Code customizations",
  "author": {
    "name": "Agent Helpers",
    "email": "contact@agent-helpers.local"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @agent-helpers/web",
    "dev:web": "npm run dev -w @agent-helpers/web",
    "dev:electron": "npm run dev -w @agent-helpers/electron",
    "build": "turbo run build",
    "build:web": "npm run build -w @agent-helpers/web",
    "build:electron": "npm run build -w @agent-helpers/electron",
    "build:linux": "npm run build:linux -w @agent-helpers/electron",
    "build:mac": "npm run build:mac -w @agent-helpers/electron",
    "lint": "turbo run lint",
    "start": "npm run start -w @agent-helpers/web"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "eslint": "^9",
    "turbo": "^2.4.0",
    "typescript": "^5"
  }
}
