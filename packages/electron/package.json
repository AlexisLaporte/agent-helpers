{
  "name": "@agent-helpers/electron",
  "version": "0.1.2",
  "description": "Electron desktop app for Agent Helpers",
  "author": {
    "name": "Agent Helpers",
    "email": "contact@agent-helpers.local"
  },
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "node ../../scripts/dev.js",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux deb",
    "build:mac": "electron-builder --mac dmg"
  },
  "dependencies": {
    "@agent-helpers/library": "workspace:*",
    "@agent-helpers/web": "workspace:*"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.agenthelpers.app",
    "productName": "Agent Helpers",
    "publish": null,
    "directories": {
      "output": "../../dist"
    },
    "files": [
      "../web/.next/standalone/**/*",
      "../web/.next/static/**/*",
      "../web/public/**/*",
      "../library/**/*",
      "main.js",
      "package.json",
      "!node_modules/@img/sharp-darwin-*/**",
      "!node_modules/@img/sharp-win32-*/**"
    ],
    "asar": false,
    "linux": {
      "target": ["deb"],
      "category": "Development",
      "icon": "../web/public/icon.png"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.developer-tools",
      "icon": "../web/public/icon.png"
    }
  }
}
